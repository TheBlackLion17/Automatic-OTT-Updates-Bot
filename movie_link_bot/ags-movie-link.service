[Unit]
Description=AGS Movie Link Telegram Bot
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ott-updates-bot
Environment=MOVIE_LINK_ENV=/root/ott-updates-bot/.env.movie_link
ExecStart=/root/ott-updates-bot/venv/bin/python -m movie_link_bot.bot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
